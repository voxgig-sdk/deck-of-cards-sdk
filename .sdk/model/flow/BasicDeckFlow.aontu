# BasicDeckFlow

main: kit: flow: BasicDeckFlow:
{
  entity: "deck",
  kind: "basic",
  name: "BasicDeckFlow",
  step: [
    {
      i: {
        ref: "deck_ref01",
        srcdatavar: "deck_ref01_data",
        suffix: "_dt0"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-deck_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicDeckFlow"
}